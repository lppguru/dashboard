<!DOCTYPE html>
<html>
<head>
  <base target="_top">
  <!-- Tailwind CSS CDN yang valid dan stabil -->
  <link href="https://jsdelivr.net" rel="stylesheet">
</head>
<body class="bg-gray-100 font-sans leading-normal tracking-normal p-6">

  <div class="max-w-7xl mx-auto">
    <!-- Header -->
    <div class="bg-gradient-to-r from-blue-800 to-blue-600 p-6 shadow-md text-2xl text-white font-bold rounded-lg mb-6">
      Dashboard Executive Organisasi
    </div>

    <!-- Ringkasan Angka (KPI) -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-6">
      <div class="bg-white border-t-4 border-blue-600 rounded-lg shadow p-6 text-center">
        <h5 class="font-bold uppercase text-gray-400 text-xs tracking-wider mb-2">Total Mahasiswa Keguruan</h5>
        <h3 class="font-bold text-4xl text-blue-600" id="kpi-mhs">Loading...</h3>
      </div>
      <div class="bg-white border-t-4 border-green-500 rounded-lg shadow p-6 text-center">
        <h5 class="font-bold uppercase text-gray-400 text-xs tracking-wider mb-2">Total Kegiatan (IE & ISOSK)</h5>
        <h3 class="font-bold text-4xl text-green-600" id="kpi-kegiatan">Loading...</h3>
      </div>
      <div class="bg-white border-t-4 border-purple-500 rounded-lg shadow p-6 text-center">
        <h5 class="font-bold uppercase text-gray-400 text-xs tracking-wider mb-2">Rata-Rata Nilai PCM</h5>
        <h3 class="font-bold text-4xl text-purple-600" id="kpi-pcm">Loading...</h3>
      </div>
    </div>

    <!-- Tata Letak Tabel -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      
      <!-- Tabel 1: Keguruan -->
      <div class="bg-white p-6 rounded-lg shadow">
        <h3 class="font-bold text-lg text-gray-800 mb-4 border-b pb-2">Ringkasan Data Kuliah Keguruan</h3>
        <div class="overflow-x-auto max-h-64">
          <table class="w-full text-left border-collapse text-sm">
            <thead>
              <tr class="bg-gray-100 text-gray-700 uppercase text-xs">
                <th class="p-3 border-b">No</th><th class="p-3 border-b">Nama</th><th class="p-3 border-b">Prodi</th><th class="p-3 border-b">Angkatan</th>
              </tr>
            </thead>
            <tbody id="table-keguruan">
              <tr><td colspan="4" class="p-4 text-center text-gray-400 italic">Memuat data...</td></tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Tabel 2: PCM -->
      <div class="bg-white p-6 rounded-lg shadow">
        <h3 class="font-bold text-lg text-gray-800 mb-4 border-b pb-2">Ringkasan Data Nilai PCM</h3>
        <div class="overflow-x-auto max-h-64">
          <table class="w-full text-left border-collapse text-sm">
            <thead>
              <tr class="bg-gray-100 text-gray-700 uppercase text-xs">
                <th class="p-3 border-b">Nama</th><th class="p-3 border-b">Prodi</th><th class="p-3 border-b">Angkatan</th><th class="p-3 border-b">Nilai PCM</th>
              </tr>
            </thead>
            <tbody id="table-pcm">
              <tr><td colspan="4" class="p-4 text-center text-gray-400 italic">Memuat data...</td></tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Tabel 3: Kegiatan (Lebar Penuh) -->
      <div class="bg-white p-6 rounded-lg shadow lg:col-span-2">
        <h3 class="font-bold text-lg text-gray-800 mb-4 border-b pb-2">Log Aktivitas Kegiatan (IE & ISOSK)</h3>
        <div class="overflow-x-auto max-h-64">
          <table class="w-full text-left border-collapse text-sm">
            <thead>
              <tr class="bg-gray-100 text-gray-700 uppercase text-xs">
                <th class="p-3 border-b">Nama</th><th class="p-3 border-b">Kegiatan</th><th class="p-3 border-b">Institusi</th><th class="p-3 border-b">Lokasi</th>
              </tr>
            </thead>
            <tbody id="table-kegiatan">
              <tr><td colspan="4" class="p-4 text-center text-gray-400 italic">Memuat data...</td></tr>
            </tbody>
          </table>
        </div>
      </div>

    </div>
  </div>

  <script>
    // Memanggil backend Google Script secara aman saat halaman terbuka
    window.addEventListener('load', function() {
      google.script.run
        .withSuccessHandler(parseAndRender)
        .withFailureHandler(function(err) {
          alert("Gagal memuat data dari Spreadsheet: " + err.message);
        })
        .getDashboardData();
    });

    function parseAndRender(rawJson) {
      // Decode data JSON dari string menjadi objek JavaScript
      var data = JSON.parse(rawJson);

      // 1. Tampilkan Angka Rangkuman Utama
      document.getElementById('kpi-mhs').innerText = data.totalMhs;
      document.getElementById('kpi-kegiatan').innerText = data.totalKegiatan;
      document.getElementById('kpi-pcm').innerText = data.rataPcm;

      // 2. Render Tabel Kuliah Keguruan
      var htmlKeguruan = '';
      if(data.keguruan.length > 0) {
        data.keguruan.forEach(function(item) {
          htmlKeguruan += `<tr class="border-b hover:bg-gray-50">
            <td class="p-3">${item.no}</td>
            <td class="p-3 font-semibold text-gray-800">${item.nama}</td>
            <td class="p-3 text-gray-600">${item.prodi}</td>
            <td class="p-3 text-gray-500">${item.angkatan}</td>
          </tr>`;
        });
      } else {
        htmlKeguruan = '<tr><td colspan="4" class="p-4 text-center text-gray-500">Tidak ada data mahasiswa ditemukan.</td></tr>';
      }
      document.getElementById('table-keguruan').innerHTML = htmlKeguruan;

      // 3. Render Tabel Nilai PCM
      var htmlPcm = '';
      if(data.pcm.length > 0) {
        data.pcm.forEach(function(item) {
          htmlPcm += `<tr class="border-b hover:bg-gray-50">
            <td class="p-3 font-semibold text-gray-800">${item.nama}</td>
            <td class="p-3 text-gray-600">${item.prodi}</td>
            <td class="p-3 text-gray-500">${item.angkatan}</td>
            <td class="p-3 text-purple-600 font-bold">${item.nilai}</td>
          </tr>`;
        });
      } else {
        htmlPcm = '<tr><td colspan="4" class="p-4 text-center text-gray-500">Tidak ada data nilai PCM ditemukan.</td></tr>';
      }
      document.getElementById('table-pcm').innerHTML = htmlPcm;

      // 4. Render Tabel Aktivitas Kegiatan
      var htmlKegiatan = '';
      if(data.kegiatan.length > 0) {
        data.kegiatan.forEach(function(item) {
          var badgeColor = item.kegiatan.includes('Edukatif') ? 'bg-green-500' : 'bg-yellow-600';
          var fullLokasi = item.kecamatan + ', ' + item.kota;
          
          htmlKegiatan += `<tr class="border-b hover:bg-gray-50">
            <td class="p-3 font-semibold text-gray-800">${item.nama}</td>
            <td class="p-3"><span class="px-2 py-1 rounded text-xs font-semibold text-white ${badgeColor}">${item.kegiatan}</span></td>
            <td class="p-3 text-gray-600">${item.institusi}</td>
            <td class="p-3 text-gray-500">${fullLokasi}</td>
          </tr>`;
        });
      } else {
        htmlKegiatan = '<tr><td colspan="4" class="p-4 text-center text-gray-500">Tidak ada log kegiatan ditemukan.</td></tr>';
      }
      document.getElementById('table-kegiatan').innerHTML = htmlKegiatan;
    }
  </script>
</body>
</html>
